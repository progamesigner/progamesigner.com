---
import { localeFromUrl, translator } from '../i18n/ui';
import Base from '../layouts/Base.astro';
import { email, pgp, profiles } from '../site.config';

const locale = localeFromUrl(Astro.url);
const t = translator(locale);
const compact = pgp.fingerprint.replaceAll(' ', '');
const importCommand = `curl -sL https://progamesigner.com${pgp.file} | gpg --import`;
const verifyCommand = `gpg --fingerprint ${compact}`;
---

<Base title={t('contactPage.title')} description={t('contactPage.description')}>
  <div class="mx-auto flex max-w-7xl flex-col gap-20 px-4 pt-6 sm:px-8">
    <header class="flex flex-col gap-8 border-t border-ink pt-3">
      <p class="meta">Yang Sheng Han — {t('hero.role')}</p>
      <h1 class="display text-[clamp(4.5rem,13vw,10.5rem)] tracking-[-0.025em]">
        {t('contactPage.title')}<span class="text-accent">.</span>
      </h1>
      <p class="max-w-3xl text-[clamp(1.5rem,2.5vw,2rem)] leading-tight font-semibold tracking-tight">{t('contactPage.lead')}</p>
    </header>

    <section aria-labelledby="contact-email" class="flex flex-wrap gap-x-12 gap-y-4 border-t border-ink pt-10">
      <h2 id="contact-email" class="flex-[1_1_16rem] display text-4xl">{t('contactPage.email')}</h2>
      <div class="flex min-w-0 flex-[3_1_32rem] flex-col gap-2">
        <a href={`mailto:${email}`} class="link text-[clamp(1.5rem,3.5vw,2.5rem)] font-semibold [overflow-wrap:anywhere]">{email}</a>
      </div>
    </section>

    <section aria-labelledby="contact-pgp" class="flex flex-wrap gap-x-12 gap-y-6 border-t border-ink pt-10">
      <h2 id="contact-pgp" class="flex-[1_1_16rem] display text-4xl">{t('contactPage.pgp')}</h2>
      <div class="flex min-w-0 flex-[3_1_32rem] flex-col gap-8">
        <dl class="grid grid-cols-[repeat(auto-fit,minmax(11rem,1fr))] gap-6">
          <div class="col-span-full flex flex-col gap-1">
            <dt class="meta uppercase">{t('contactPage.fingerprint')}</dt>
            <dd class="font-mono text-[clamp(1rem,2vw,1.375rem)] [overflow-wrap:anywhere]">{pgp.fingerprint}</dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="meta uppercase">{t('contactPage.algorithm')}</dt>
            <dd>{pgp.algorithm}</dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="meta uppercase">{t('contactPage.created')}</dt>
            <dd><time datetime={pgp.created}>{pgp.created}</time></dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="meta uppercase">{t('contactPage.uid')}</dt>
            <dd class="[overflow-wrap:anywhere]">{pgp.userId}</dd>
          </div>
        </dl>
        <p class="max-w-2xl text-muted">{t('contactPage.uidNote')}</p>
        <div class="flex flex-col gap-3">
          <h3 class="meta uppercase">{t('contactPage.import')}</h3>
          <pre class="overflow-x-auto border border-rule bg-surface p-4 font-mono text-[13px]"><code>{importCommand}
{verifyCommand}</code></pre>
          <div class="flex flex-wrap gap-x-6 gap-y-2">
            <a href={pgp.file} class="link font-semibold" download>{t('contact.download')}</a>
            <a href={pgp.keyserver} class="link">{t('contactPage.keyserver')} ↗</a>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="contact-elsewhere" class="flex flex-wrap gap-x-12 gap-y-4 border-t border-ink pt-10">
      <h2 id="contact-elsewhere" class="flex-[1_1_16rem] display text-4xl">{t('contactPage.elsewhere')}</h2>
      <ul class="flex min-w-0 flex-[3_1_32rem] flex-col">
        {
          profiles.map((profile) => (
            <li>
              <a href={profile.href} rel="me" class="index-row flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-rule py-4">
                <span class="index-name text-2xl font-extrabold [font-stretch:80%]">
                  {profile.label === 'Blog' ? t('nav.blog') : profile.label}
                </span>
                <span class="flex items-baseline gap-3 meta">
                  {profile.handle}
                  <span aria-hidden="true" class="index-arrow text-accent">↗</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>
