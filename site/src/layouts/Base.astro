---
import { ClientRouter } from 'astro:transitions';
import Analytics from '../components/Analytics.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { htmlLang, type Locale, localeFromUrl, ogLocale, switchLocalePath, translator } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const locale: Locale = localeFromUrl(Astro.url);
const t = translator(locale);
const { title, description = t('site.description'), noindex = false } = Astro.props;
const pageTitle = title ? `${title} — progamesigner` : t('site.title');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${Astro.site}#person`,
      name: 'Yang Sheng Han',
      alternateName: 'progamesigner',
      jobTitle: 'Software Engineer',
      url: Astro.site?.toString(),
      address: { '@type': 'PostalAddress', addressLocality: 'Taipei', addressCountry: 'TW' },
      sameAs: [
        'https://github.com/progamesigner',
        'https://x.com/progamesigner',
        'https://www.linkedin.com/in/progamesigner',
        'https://0x148.com',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#website`,
      url: Astro.site?.toString(),
      name: 'progamesigner',
      inLanguage: ['en', 'zh-Hant-TW'],
      publisher: { '@id': `${Astro.site}#person` },
    },
  ],
};
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Yang Sheng Han" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(switchLocalePath(Astro.url, 'en'), Astro.site)} />
    <link rel="alternate" hreflang="zh-Hant-TW" href={new URL(switchLocalePath(Astro.url, 'zh-tw'), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(switchLocalePath(Astro.url, 'en'), Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="pgpkey" href="/pgp.asc" />
    <meta name="theme-color" content="#F3F1EC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161615" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="progamesigner" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@progamesigner" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      // Apply the saved theme before first paint; the choice survives client-side navigation.
      (() => {
        const apply = () => {
          let theme = null;
          try {
            theme = localStorage.getItem('theme');
          } catch {}
          if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    <ClientRouter />
    <Analytics />
  </head>
  <body class="min-h-dvh bg-bg text-ink">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-bg">
      {t('skip')}
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
