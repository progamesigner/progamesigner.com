---
import { localeFromUrl, localizePath, translator } from '../i18n/ui';
import { email, pgp, profiles } from '../site.config';

const locale = localeFromUrl(Astro.url);
const t = translator(locale);
---

<section id="contact" class="reveal grid scroll-mt-8 grid-cols-[repeat(auto-fit,minmax(17.5rem,1fr))] gap-10 border-t-2 border-ink pt-6">
  <h2 class="display text-7xl">{t('contact.title')}</h2>
  <div class="flex flex-col gap-3">
    <p class="text-muted">{t('contact.lead')}</p>
    <a href={`mailto:${email}`} class="link text-[22px] font-semibold break-all">{email}</a>
    <div class="flex flex-col gap-1 border border-rule bg-surface px-4 py-3.5">
      <span class="meta uppercase">OpenPGP · {pgp.algorithm}</span>
      <code class="font-mono text-[13px] [overflow-wrap:anywhere] [word-break:normal]">{pgp.fingerprint}</code>
      <span class="meta">{t('contact.keyNote', { uid: pgp.userId })}</span>
      <a href={pgp.file} class="link text-[13px]" download>{t('contact.download')}</a>
    </div>
  </div>
  <div class="flex flex-col justify-between gap-6">
    <ul class="flex flex-col gap-2.5 text-[15px]">
      {
        profiles.map((profile) => (
          <li>
            <a class="link" href={profile.href} rel="me">
              {profile.label === 'Blog' ? `${t('nav.blog')} — ${profile.handle}` : profile.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={localizePath('/contact/', locale)} class="link w-fit font-semibold">{t('contact.more')} →</a>
  </div>
</section>
