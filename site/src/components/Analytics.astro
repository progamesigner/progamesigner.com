---
// Google Analytics 4. Loads only in production builds that set PUBLIC_GA_ID,
// and runs in a Web Worker through Partytown so it stays off the main thread.
const id = import.meta.env.PUBLIC_GA_ID;
const enabled = import.meta.env.PROD && typeof id === 'string' && /^G-[A-Z0-9]+$/.test(id);
---

{
  enabled && (
    <>
      <script type="text/partytown" src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />
      <script type="text/partytown" define:vars={{ id }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function gtag() {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', id, { send_page_view: false });
      </script>
      <script is:inline>
        // View transitions swap pages without a full load, so report every page view explicitly.
        document.addEventListener('astro:page-load', () => {
          window.gtag?.('event', 'page_view', { page_location: location.href, page_title: document.title });
        });
      </script>
    </>
  )
}
